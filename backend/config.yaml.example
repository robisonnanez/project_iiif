# =============================================================================
# CONFIGURACION DEL SERVIDOR IIIF PDF
# =============================================================================

# Backend principal de almacenamiento: local o mysql.
# Si STORAGE_BACKEND/DB_CONNECTION es mysql, la metadata va a MySQL y los PDFs
# e imagenes quedan en las rutas configuradas abajo.
STORAGE_BACKEND: "local"
DB_CONNECTION: "local"
DB_HOST: "127.0.0.1"
DB_PORT: "3306"
DB_DATABASE: "DB_DATABASE"
DB_USERNAME: "DB_USERNAME"
DB_PASSWORD: "DB_PASSWORD"

server:
  port: "8080"
  mode: "debug"

storage:
  backend: "local"
  data_path: "./data"
  pdfs_path: "./data/pdfs"
  images_path: "./data/images"
  documents_path: "./data/documents"
  thumbnails_path: "./data/thumbnails"
  manifests_path: "./data/manifests"

# Tambien puedes usar las claves DB_* de arriba; si estan presentes, tienen prioridad.
database:
  mysql:
    host: "127.0.0.1"
    port: "3306"
    user: "project_iiif"
    password: "CAMBIAR_PASSWORD"
    database: "project_iiif"
    charset: "utf8mb4"
    parse_time: true

pdf:
  max_file_size: 104857600
  allowed_formats:
    - "pdf"
  temp_path: "./data/temp"

iiif:
  base_url: "https://tu-dominio.com"
  api_version: "3"
  max_width: 2048
  max_height: 2048
  cache_enabled: true
  cache_ttl: 3600
  tile_size: 512
  scale_factors: [1, 2, 4, 8]

conversion:
  default_format: "jpg"
  default_quality: 85
  enable_ocr: false
  dpi: 150
  background_color: "white"

security:
  enable_auth: false
  log_level: "info"
  cors_origins:
    - "https://tu-dominio.com"
    - "https://www.tu-dominio.com"
    - "https://*.tu-dominio.com"
    - "http://localhost:3000"
    - "http://localhost:5173"
  max_concurrent_uploads: 5

frontend:
  enabled: false
  path: "./frontend"
  require_auth: true
  username: "admin"
  password: "CAMBIAR_PASSWORD"

performance:
  max_workers: 4
  queue_size: 100
  cleanup_interval: 3600
  max_cache_size: "1GB"
