# =============================================================================
# CONFIGURACION DEL SERVIDOR IIIF PDF
# =============================================================================

# Backend principal de almacenamiento: local, mysql, postgres o mongodb.
# Si STORAGE_BACKEND/DB_CONNECTION es mysql, postgres o mongodb, la metadata va
# a la base de datos configurada y los binarios pueden vivir en BLOB/GridFS
# segun binary_storage.mode.
STORAGE_BACKEND: "local"
DB_CONNECTION: "local"
DB_HOST: "127.0.0.1"
DB_PORT: "3306"
DB_DATABASE: "DB_DATABASE"
DB_USERNAME: "DB_USERNAME"
DB_PASSWORD: "DB_PASSWORD"

# Almacenamiento binario S3 compatible (RustFS, MinIO o AWS S3).
# Para activarlo usa FILESYSTEM_DISK: "s3" y binary_storage.mode: "s3".
FILESYSTEM_DISK: "local"
AWS_ACCESS_KEY_ID: "TU_ACCESS_KEY_DE_RUSTFS"
AWS_SECRET_ACCESS_KEY: "TU_SECRET_KEY_DE_RUSTFS"
AWS_DEFAULT_REGION: "us-east-1"
AWS_BUCKET: "mi-proyecto"
AWS_ENDPOINT: "http://127.0.0.1:9000"
AWS_USE_PATH_STYLE_ENDPOINT: true

server:
  port: "8080"
  mode: "debug"

storage:
  backend: "local"
  data_path: "./data"
  pdfs_path: "./data/pdfs"
  images_path: "./data/images"
  documents_path: "./data/documents"
  thumbnails_path: "./data/thumbnails"
  manifests_path: "./data/manifests"

# Tambien puedes usar las claves DB_* de arriba; si estan presentes, tienen prioridad.
database:
  # Ejecuta las migraciones pendientes de forma idempotente antes de iniciar el servidor.
  auto_migrate: false
  mysql:
    host: "127.0.0.1"
    port: "3306"
    user: "project_iiif"
    password: "CAMBIAR_PASSWORD"
    database: "project_iiif"
    charset: "utf8mb4"
    parse_time: true
  postgres:
    host: "127.0.0.1"
    port: "5432"
    user: "postgres"
    password: "CAMBIAR_PASSWORD"
    database: "project_iiif"
    sslmode: "disable"
    schema: "public"
  mongodb:
    host: "127.0.0.1"
    port: "27017"
    user: ""
    password: "CAMBIAR_PASSWORD"
    database: "project_iiif"
    auth_source: "admin"
    direct_connection: true
    server_selection_timeout_ms: 2000

pdf:
  max_file_size: 104857600
  allowed_formats:
    - "pdf"
  temp_path: "./data/temp"

binary_storage:
  # Valores: local, database o s3.
  mode: "local"
  temp_path: "./data/temp"

iiif:
  base_url: "https://tu-dominio.com"
  api_version: "3"
  max_width: 2048
  max_height: 2048
  cache_enabled: true
  cache_ttl: 3600
  tile_size: 512
  scale_factors: [1, 2, 4, 8]

conversion:
  default_width: 1241
  default_height: 1754
  default_format: "jpg"
  default_quality: 85
  enable_ocr: false
  dpi: 150
  background_color: "white"

ocr:
  enabled: false
  auto_after_conversion: false
  default_mode: "hybrid"
  workers: 2
  page_timeout_seconds: 120
  retries_per_page: 2
  render_dpi: 300
  min_text_chars: 40
  candidate_languages: ["spa", "eng", "fra", "por"]
  fallback_languages: ["spa"]
  language_detection:
    enabled: true
    sample_pages: 5
    min_sample_chars: 200
    minimum_confidence: 0.70
    max_languages: 2
  artifacts:
    gzip: true

security:
  enable_auth: false
  log_level: "info"
  cors_origins:
    - "https://tu-dominio.com"
    - "https://www.tu-dominio.com"
    - "https://*.tu-dominio.com"
    - "http://localhost:3000"
    - "http://localhost:5173"
  max_concurrent_uploads: 5

frontend:
  enabled: false
  path: "./frontend"
  require_auth: true
  username: "admin"
  password: "CAMBIAR_PASSWORD"
  menu_orientation: "horizontal" # horizontal | vertical

projects:
  enabled: true
  default_project: "default"
  require_project: false
  allow_dynamic_tenants: false
  items:
    - key: "default"
      name: "Proyecto por defecto"
      multitenant: false
      tenants: []
    - key: "metavisor"
      name: "Metavisor"
      multitenant: true
      tenants_endpoint: "https://api.ejemplo.com/tenants"
      tenants_auth_type: "bearer"
      tenants_auth_token: "cambia-este-token"
      tenants:
        - "sunat"
        - "demo"
        - "uniguajira"

performance:
  max_workers: 4
  queue_size: 100
  cleanup_interval: 3600
  max_cache_size: "1GB"

migration:
  enabled: true
  allowed_local_roots:
    - "./data"
    - "/var/lib/project_iiif"
  max_log_lines: 1000
  ssh:
    connect_timeout_sec: 15
    allowed_hosts: []
